# Optional exact origins for a separately hosted frontend. Same-origin needs no CORS.
ALLOWED_ORIGINS=http://localhost:5173
# Set to 0 to disable outbound HEAD checks; lexical analysis still works.
ONLINE_SCAN_ENABLED=1
# Production artifact is local, trusted, and checksum-verified using models/model_metadata.json.
# Frontend build-time browser validation limits, separate from backend training limits.
VITE_DATASET_MAX_MIB=25
VITE_DATASET_MAX_ROWS=1000000
VITE_DATASET_MAX_UNIQUE_URLS=250000
